PORT=5000
JWT_ACCESS_SECRET=your_jwt_access_secret_hex_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Supabase / PostgreSQL Database Configuration
# In production, ensure DATABASE_URL uses sslmode=require or secure validation.
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require&prepared_statement_cache_size=0

# Individual Parameters (For Direct Connections - Port 5432)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_PORT=5432
DB_POOL_MAX=20
DB_SSL_REJECT_UNAUTHORIZED=true

MEDIA_SIGN_SECRET=your_media_signing_secret_key

# Sentry Error Tracking Configuration (Optional)
SENTRY_DSN=
